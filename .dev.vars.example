# Local variables for `wrangler pages dev` (copy to .dev.vars; never commit it).
# Email is sent by the contact-mailer Worker through the CONTACT_MAILER service
# binding (see DEPLOYMENT.md). Without that binding, /contact and submit_contact
# return an explicit "not sent" error.

# Set to 1 to validate submissions without sending email
# CONTACT_DRY_RUN=1
